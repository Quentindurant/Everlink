# prisma/schema.prisma datasource
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Mot de passe du compte ADMIN créé par `bun run db:seed` (admin@everlink.local).
# Obligatoire: le seed échoue si la variable est absente. Le upsert ne met pas à jour un compte
# existant, changer cette valeur ne fait donc rien après le premier seed.
SEED_ADMIN_PASSWORD=

# Cron endpoint (POST /api/cron/sheets-sync), expected in the X-Cron-Secret header
CRON_SECRET=

# Google Sheets sync
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Envoi des mails de migration (SMTP). SMTP_SECURE=1 pour TLS implicite (port 465).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=migration.ext@everlink-services.fr
# Numéro GC affiché dans les mails (variable {numero_gc})
NUMERO_GC=

# Tableau de suivi maison (remplace le Zoho Sheet — décision « Notre tableau seulement »).
# API NestJS du repo TableauSuivieGcDev, prod : https://suivie.appgcd.fr
# Compte de service à créer dans les Paramètres du tableau (utilisateur dédié Everlink).
# Sert au push des dossiers (bouton « Ajouter au tableau de suivi »), à la vue live de la
# page Techniciens, à la disponibilité des techniciens et au pull cron
# (POST /api/cron/suivi-pull — alias historique /api/cron/zoho-pull —, header X-Cron-Secret).
SUIVI_API_URL=https://suivie.appgcd.fr
SUIVI_API_EMAIL=
SUIVI_API_PASSWORD=

# ⚠️ DÉPRÉCIÉ — Zoho Sheet (ancien tableau de suivi). L'app ne l'utilise plus ; variables
# conservées uniquement pour le script de diagnostic legacy scripts/zoho-verifier.ts.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SHEET_RESOURCE_ID=36x6e6110bc0a380e4502aa19a2846f5908ba
ZOHO_WORKSHEET=
# Optional escape hatch: set to "1" to allow a sync to write zero rows to a tab (normally
# skipped to avoid wiping a Sheet tab that still has real data when the DB is empty).
SHEETS_SYNC_ALLOW_EMPTY=

# Suivi de colis La Poste/Chronopost (API Suivi v2, en-tête X-Okapi-Key). Même clé que le
# projet Synapse. Rafraîchi par POST /api/cron/tracking-sync (header X-Cron-Secret).
API_KEY_LAPOSTE=
