/system script add name=Bootautoprov owner=admin policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="\r\
    \n       :log warning \"Script Bootautoprov loaded\";\r\
    \n       :if ([/ping 178.255.160.71 interval=5s count=10]!=0) do={\r\
    \n       :do {:log warning \"ping 178.255.160.71 successful - it try to get final config on Sophia\";\r\
    \n       :global serial [/sy ro g s ];\r\
    \n       :global url http://configcpe.sewan.fr/airdevices/;\r\
    \n       :tool fetch url=(\$url .\$serial.\".txt\") dst-path=(\"/flash/\".\$serial.\".txt\");\r\
    \n\r\
    \n    ##\r\
    \n    ## We are only interested on the first line \r\
    \n    ##\r\
    \n       :global content [/file get [/file find name=(\"flash/\".\$serial.\".txt\")] contents] ;\r\
    \n       #:log warning (\"content: \" . \$content)   \r\
    \n\r\
    \n       :global contentLen [ :len \$content ] ;\r\
    \n       :global lineEnd 0;\r\
    \n       :global firstline \"\";\r\
    \n       :global lastEnd 0;\r\
    \n        # pour CR LF\r\
    \n        #:set lineEnd [:find \$content \"\\r\\n\" \$lastEnd ] ;\r\
    \n        # pour LF\r\
    \n       :set lineEnd [:find \$content \"\\n\" \$lastEnd ] ;\r\
    \n       :set firstline [:pick \$content \$lastEnd \$lineEnd] ;\r\
    \n       #:log warning (\"firstline is : \" . \$firstline)   \r\
    \n    ##\r\
    \n    ## Now we need to find the configuration ID\r\
    \n    ## of the configuration generated by Sophia \r\
    \n    ##  \r\
    \n       :global decimalPos \"0\";\r\
    \n       :global sophiaconfid\r\
    \n       \r\
    \n       :set decimalPos [:find \$firstline \"=\"];\r\
    \n       :set decimalPos (\$decimalPos+1);\r\
    \n       :set sophiaconfid [:pick \$firstline \$decimalPos [:len \$firstline]];\r\
    \n       #:log warning (\"sophiaconfid is : \" . \$sophiaconfid)\r\
    \n       :global WorkString [/system identity get name];\r\
    \n       :global bclcondition ([find \$WorkString \"_\"]>=0)\r\
    \n       #:log warning (\"bclcondition is : \" . \$bclcondition)\r\
    \n       :while (\$bclcondition=true) do={\r\
    \n          #:log info  (\"IN LOOP\")\r\
    \n          :set decimalPos [:find \$WorkString \"_\"];\r\
    \n          :set decimalPos (\$decimalPos+1);\r\
    \n          #:log warning (\"decimalPos+1 is : \" . \$decimalPos)\r\
    \n          :set WorkString [:pick \$WorkString \$decimalPos [:len \$WorkString]];\r\
    \n          #:log warning (\"curconfid is : \" . \$WorkString)\r\
    \n          :global bclcondition ([find \$WorkString \"_\"]>=0)\r\
    \n       } \r\
    \n      :global DeviceCurrentConfId \$WorkString \r\
    \n    \r\
    \n    \r\
    \n    ##\r\
    \n    ## Now we check if Sophia configuration file\r\
    \n    ## is recent ( greater ID ). if this is the case,\r\
    \n    ## the router restarts with the new version.\r\
    \n    ##   \r\
    \n       :if (( \$sophiaconfid > \$DeviceCurrentConfId ) = false)  do={\r\
    \n            :log warning (\"No need to update - old_ID: \" . \$DeviceCurrentConfId . \" and new_ID: \" . \$sophiaconfid);\r\
    \n            } else={\r\
    \n            :log warning (\"system will restart on new configuration - old_ID: \" . \$DeviceCurrentConfId . \" and new_ID: \" . \$sophiaconfid);\r\
    \n            :delay 5s\r\
    \n                 :global url http://configcpe.sewan.fr/airdevices/;\r\
    \n             :tool fetch url=(\$url .\$serial) dst-path=(\"/flash/\".\$serial.\".rsc\");\r\
    \n             :delay 5s\r\
    \n            /system reset-configuration no-defaults=yes run-after-reset=(\"flash/\".\$serial.\".rsc\")\r\
    \n\r\
    \n            y\r\
    \n\r\
    \n           }\r\
    \n      } on-error={\r\
    \n    :log error \"Error occur on Bootautoprov script.\"\r\
    \n    }\r\
    \n}"




/system script add name=CheckNTPServers owner=admin policy=read,write,test source="\r\
    \n# Check and set NTP servers \r\
    \n\r\
    \n# NTP pools to use (check ntp.sewan.fr)\r\
    \n:global SYSntp \"ntp.sewan.fr\";\r\
    \n\r\
    \n# Resolve the two ntp pool hostnames\r\
    \n:local ntpip [:resolve \$SYSntp];\r\
    \n\r\
    \n# Get the current settings\r\
    \n:local ntpcur [/system ntp client get primary-ntp];\r\
    \n\r\
    \n# Define a variable so we know if anything's changed.\r\
    \n:local changea 0;\r\
    \n\r\
    \n# Debug output\r\
    \n:put (\"Old: \" . \$ntpcur . \" New: \" . \$ntpip);\r\
    \n\r\
    \n# Change primary if required\r\
    \n:if (\$ntpip != \$ntpcur) do={\r\
    \n    :put \"Changing primary NTP\";\r\
    \n    /system ntp client set primary-ntp=\"\$ntpip\";\r\
    \n    /ip dhcp-server network set numbers=0 ntp-server=\"\$ntpip\";\r\
    \n    :set changea 1;\r\
    \n    }"






